        // Enroll a new user with their fingerprint template
        public int EnrollUser(string fullName, string employeeId, byte[] template, string address, string contactNumber)
        {
            if (IsPersonAlreadyRegistered(fullName, address))
                throw new InvalidOperationException(PersonAlreadyRegisteredMessage);

            using var conn = CreateOpenConnection();
            bool hasEmail = ColumnExists(conn, "users", "email");
            bool hasName = ColumnExists(conn, "users", "name");
            bool hasPassword = ColumnExists(conn, "users", "password");
            bool hasUsername = ColumnExists(conn, "users", "username");
            bool hasAddress = ColumnExists(conn, "users", "address");
            bool hasContactNumber = ColumnExists(conn, "users", "contact_number");

            var generatedEmail = hasEmail ? BuildGeneratedEmployeeEmail(employeeId, fullName) : null;
            var columns = new List<string> { "full_name", "employee_id", "fp_template", "role" };
            var values = new List<string> { "@name", "@eid", "@tpl", "'employee'" };

            if (hasName)
            {
                columns.Add("name");
                values.Add("@name");
            }

            if (hasEmail)
            {
                columns.Add("email");
                values.Add("@email");
            }

            if (hasUsername)
            {
                columns.Add("username");
                values.Add("@username");
            }

            if (hasPassword)
            {
                columns.Add("password");
                values.Add("@password");
            }
            if (hasAddress)
            {
                columns.Add("address");
                values.Add("@address");
            }
            if (hasContactNumber)
            {
                columns.Add("contact_number");
                values.Add("@contact");
            }

            string sql = $@"INSERT INTO users ({string.Join(", ", columns)})
                            VALUES ({string.Join(", ", values)});
                            SELECT LAST_INSERT_ID();";
            using var cmd = new MySqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("@name", fullName);
            cmd.Parameters.AddWithValue("@eid", employeeId);
            cmd.Parameters.AddWithValue("@tpl", template);
            if (hasEmail)
                cmd.Parameters.AddWithValue("@email", generatedEmail);
            if (hasUsername)
                cmd.Parameters.AddWithValue("@username", generatedEmail ?? employeeId ?? fullName);
            if (hasPassword)
                cmd.Parameters.AddWithValue("@password", string.Empty);
            if (hasAddress)
                cmd.Parameters.AddWithValue("@address", address ?? string.Empty);
            if (hasContactNumber)
                cmd.Parameters.AddWithValue("@contact", contactNumber ?? string.Empty);
            return Convert.ToInt32(cmd.ExecuteScalar());
        }

        private static string BuildGeneratedEmployeeEmail(string employeeId, string fullName)
        {
            string baseValue = !string.IsNullOrWhiteSpace(employeeId) ? employeeId.Trim() : fullName?.Trim() ?? "employee";
            var sanitizedChars = new List<char>(baseValue.Length);
            foreach (char ch in baseValue.ToLowerInvariant())
            {
                if ((ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9'))
                    sanitizedChars.Add(ch);
            }

            string sanitized = sanitizedChars.Count > 0 ? new string(sanitizedChars.ToArray()) : "employee";
            return $"{sanitized}.{Guid.NewGuid():N}@fingerprint.local";
        }

        // Load all users with their fingerprint templates (for matching)
        public List<UserModel> GetAllUsersWithTemplates()
        {
            var users = new List<UserModel>();
            using var conn = CreateOpenConnection();
            string sql = @"SELECT
                               id,
                               COALESCE(NULLIF(name, ''), NULLIF(full_name, ''), '(Unnamed)') AS full_name,
                               employee_id,
                               fp_template
                           FROM users";
            using var cmd = new MySqlCommand(sql, conn);
            using var reader = cmd.ExecuteReader();
            while (reader.Read())
            {
                users.Add(new UserModel
                {
                    Id = reader.GetInt32("id"),
                    FullName = reader.GetString("full_name"),
                    EmployeeId = reader.IsDBNull(reader.GetOrdinal("employee_id"))
                                 ? "" : reader.GetString("employee_id"),
                    FpTemplate = reader["fp_template"] as byte[]
                });
            }
            return users;
        }

        /// <summary>
        /// Real-time check: an employee (users.id) that still has a non-null template in MySQL.
        /// If the user was deleted or the template was cleared, returns null so the app does not trust cached lists or stale ZK matches.
        /// </summary>
        public UserModel TryGetUserWithValidTemplateById(int userId)
        {
            if (userId < 1) return null;
            using var conn = CreateOpenConnection();
            const string sql = @"SELECT
                                     id,
                                     COALESCE(NULLIF(name, ''), NULLIF(full_name, ''), '(Unnamed)') AS full_name,
                                     employee_id,
                                     fp_template
                                 FROM users
                                 WHERE id = @id AND fp_template IS NOT NULL";
            using var cmd = new MySqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("@id", userId);
            using var reader = cmd.ExecuteReader();
            if (!reader.Read()) return null;
            return new UserModel
            {
                Id = reader.GetInt32("id"),
                FullName = reader.GetString("full_name"),
                EmployeeId = reader.IsDBNull(reader.GetOrdinal("employee_id"))
                    ? "" : reader.GetString("employee_id"),
                FpTemplate = reader["fp_template"] as byte[]
            };
        }

