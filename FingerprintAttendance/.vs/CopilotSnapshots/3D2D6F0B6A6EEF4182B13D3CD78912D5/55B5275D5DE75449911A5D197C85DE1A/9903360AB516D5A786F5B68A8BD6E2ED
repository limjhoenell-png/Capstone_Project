        /// <summary>
        /// Auto-attendance policy:
        /// - no previous log or previous OUT => next scan logs IN
        /// - previous IN => next scan logs OUT, but only after the minimum gap
        /// </summary>
        public bool TryDetermineNextAttendanceEntry(int userId, TimeSpan minimumGapBeforeOut, out string nextEntryType, out DateTime? nextAllowedOutAt)
        {
            nextEntryType = "IN";
            nextAllowedOutAt = null;

            using var conn = CreateOpenConnection();
            const string sql = @"
                SELECT entry_type, log_time
                FROM attendance_log
                WHERE user_id = @uid
                ORDER BY log_time DESC, id DESC
                LIMIT 1";
            using var cmd = new MySqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("@uid", userId);
            using var reader = cmd.ExecuteReader();
            if (!reader.Read())
                return true; // first scan -> IN

            string lastEntryType = (reader.GetString("entry_type") ?? string.Empty).Trim().ToUpperInvariant();
            DateTime lastLogTime = reader.GetDateTime("log_time");

            if (lastEntryType == "IN")
            {
                nextEntryType = "OUT";
                nextAllowedOutAt = lastLogTime.Add(minimumGapBeforeOut);
                return DateTime.Now >= nextAllowedOutAt.Value;
            }

            nextEntryType = "IN";
            return true;
        }

        // Get attendance records (for the log viewer)
        public List<AttendanceModel> GetAttendanceLogs(DateTime date)
        {
            var logs = new List<AttendanceModel>();
            using var conn = CreateOpenConnection();
            string sql = @"SELECT
                               a.id,
                               a.user_id,
                               COALESCE(NULLIF(u.name, ''), NULLIF(u.full_name, ''), '(Unnamed)') AS full_name,
                               a.log_time,
                               a.entry_type
                           FROM attendance_log a
                           JOIN users u ON a.user_id = u.id
                           WHERE DATE(a.log_time) = @date
                           ORDER BY a.log_time DESC";
            using var cmd = new MySqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("@date", date.ToString("yyyy-MM-dd"));
            using var reader = cmd.ExecuteReader();
            while (reader.Read())
            {
                logs.Add(new AttendanceModel
                {
                    Id = reader.GetInt32("id"),
                    UserId = reader.GetInt32("user_id"),
                    FullName = reader.GetString("full_name"),
                    LogTime = reader.GetDateTime("log_time"),
                    EntryType = reader.GetString("entry_type")
                });
            }
            return logs;
        }

