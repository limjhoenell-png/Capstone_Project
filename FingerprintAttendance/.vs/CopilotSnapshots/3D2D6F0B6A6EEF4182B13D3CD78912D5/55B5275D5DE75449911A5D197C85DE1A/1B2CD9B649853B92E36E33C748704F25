            };
            btnFingerprint.FlatAppearance.BorderSize = 0;
            btnFingerprint.Click += (_, __) => methodForm.DialogResult = DialogResult.Yes;

            var choiceGap = new Panel { Dock = DockStyle.Top, Height = 10 };
