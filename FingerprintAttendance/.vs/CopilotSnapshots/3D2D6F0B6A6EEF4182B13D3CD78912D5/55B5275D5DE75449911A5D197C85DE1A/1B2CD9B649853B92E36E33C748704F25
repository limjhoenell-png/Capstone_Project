        /// <summary>
        /// Visitor logbook grid exposes visitor PII — restrict to <c>admin</c> or <see cref="DatabaseHelper.RoleLogbookPrivileged"/> accounts.
        /// </summary>
        private bool PromptForLogbookPrivilegedLogin()
        {
            if (!_db.HasAnyActiveUserForRoles("admin", DatabaseHelper.RoleLogbookPrivileged))
            {
                MessageBox.Show(
                    "No staff account is configured for visitor logbook access.\n\n" +
                    "An administrator must assign the \"admin\" or \"logbook\" role to your user in the database.",
                    "Cannot Authenticate",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning);
                return false;
            }

            var method = PromptAuthMethodChoice(
                "Visitor Logbook Access",
                "Authenticate to view visitor records",
                allowCredentials: true,
                allowFingerprint: true,
                fingerprintLabel: "Scan authorized fingerprint");

            if (!method.HasValue)
                return false;

            if (method.Value == AuthMethod.Credentials)
            {
                if (!TryPromptCredentials(
                    "Visitor Logbook Login",
                    "Admin or authorized logbook personnel",
                    out string username,
                    out string password))
                    return false;

                if (_db.ValidateCredentialsForRoles(username, password, "admin", DatabaseHelper.RoleLogbookPrivileged))
                    return true;

                MessageBox.Show(
                    "Invalid credentials or this account cannot access visitor records.",
                    "Authentication Failed",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error);
                return false;
            }

            if (TryAuthenticateByFingerprint(
                    "Visitor Logbook",
                    "Scan an admin or authorized logbook fingerprint",
                    out int userId) &&
                _db.UserIdHasAnyRole(userId, "admin", DatabaseHelper.RoleLogbookPrivileged))
                return true;

            MessageBox.Show(
                "Fingerprint authentication failed or this account cannot access visitor records.",
                "Authentication Failed",
                MessageBoxButtons.OK,
                MessageBoxIcon.Error);
            return false;
        }

