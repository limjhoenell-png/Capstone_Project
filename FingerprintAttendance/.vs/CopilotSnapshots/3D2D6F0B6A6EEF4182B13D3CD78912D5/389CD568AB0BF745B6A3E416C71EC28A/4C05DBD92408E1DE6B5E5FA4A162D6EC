                SELECT EXISTS(
                    SELECT 1 FROM logbook x
                    WHERE x.fingerprint_id = @fid
                      AND x.fp_template IS NOT NULL
                      AND COALESCE(NULLIF(x.transaction_type, ''), @visitorType) = @visitorType
                    LIMIT 1
                )";
            using var cmd = new MySqlCommand(sql, conn);
