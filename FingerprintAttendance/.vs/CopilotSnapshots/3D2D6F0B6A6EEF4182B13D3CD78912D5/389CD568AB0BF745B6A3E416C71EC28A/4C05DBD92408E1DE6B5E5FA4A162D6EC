        // Log attendance (IN or OUT) - implements first punch (time_in) and second punch (time_out)
        public void LogAttendance(int userId, string entryType)
        {
            using var conn = CreateOpenConnection();

            // Get today's date in LOCAL time (not server time, to match GetAttendanceLogs)
            DateTime today = DateTime.Now.Date;

            if (string.Equals(entryType, "IN", StringComparison.OrdinalIgnoreCase))
            {
                // First punch: Try to insert a new row for today. If exists, ignore (already has time_in).
                string insertSql = @"
                    INSERT IGNORE INTO attendances (user_id, attendance_date, time_in, created_at, updated_at)
                    VALUES (@uid, @date, NOW(), NOW(), NOW())";
                using var insertCmd = new MySqlCommand(insertSql, conn);
                insertCmd.Parameters.AddWithValue("@uid", userId);
                insertCmd.Parameters.AddWithValue("@date", today.ToString("yyyy-MM-dd"));
                insertCmd.ExecuteNonQuery();
            }
            else if (string.Equals(entryType, "OUT", StringComparison.OrdinalIgnoreCase))
            {
                // Second punch: Update time_out for today's row (if it exists with a valid time_in).
                string updateSql = @"
                    UPDATE attendances
                    SET time_out = NOW(), updated_at = NOW()
                    WHERE user_id = @uid
                      AND attendance_date = @date
                      AND time_in IS NOT NULL
                      AND time_out IS NULL";
                using var updateCmd = new MySqlCommand(updateSql, conn);
                updateCmd.Parameters.AddWithValue("@uid", userId);
                updateCmd.Parameters.AddWithValue("@date", today.ToString("yyyy-MM-dd"));
                updateCmd.ExecuteNonQuery();
            }
        }

        /// <summary>
        /// Auto-attendance policy:
        /// - no previous log or previous OUT => next scan logs IN
        /// - previous IN => next scan logs OUT, but only after the minimum gap
        /// </summary>
        public bool TryDetermineNextAttendanceEntry(int userId, TimeSpan minimumGapBeforeOut, out string nextEntryType, out DateTime? nextAllowedOutAt)
        {
            nextEntryType = "IN";
            nextAllowedOutAt = null;

            using var conn = CreateOpenConnection();
            const string sql = @"
                SELECT time_in, time_out
                FROM attendances
                WHERE user_id = @uid
                  AND attendance_date = @date
                LIMIT 1";
            using var cmd = new MySqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("@uid", userId);
            cmd.Parameters.AddWithValue("@date", DateTime.Now.Date.ToString("yyyy-MM-dd"));
            using var reader = cmd.ExecuteReader();
            if (!reader.Read())
                return true; // first scan -> IN

            // Undo my previous bad change
            string lastEntryType = (reader.GetString("entry_type") ?? string.Empty).Trim().ToUpperInvariant();
            DateTime lastLogTime = reader.GetDateTime("log_time");

            if (lastEntryType == "IN")
            {
                nextEntryType = "OUT";
                nextAllowedOutAt = lastLogTime.Add(minimumGapBeforeOut);
                return DateTime.Now >= nextAllowedOutAt.Value;
            }

            nextEntryType = "IN";
            return true;
        }

        // Get attendance records (for the log viewer)
        public List<AttendanceModel> GetAttendanceLogs(DateTime date)
        {
            var logsByUser = new Dictionary<int, AttendanceModel>();
            using var conn = CreateOpenConnection();
            string sql = @"SELECT
                               a.user_id,
                               COALESCE(NULLIF(u.name, ''), NULLIF(u.full_name, ''), '(Unnamed)') AS full_name,
                               a.log_time,
                               a.entry_type
                           FROM attendance_log a
                           JOIN users u ON a.user_id = u.id
                           WHERE DATE(a.log_time) = @date
                           ORDER BY a.log_time ASC, a.id ASC";
            using var cmd = new MySqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("@date", date.ToString("yyyy-MM-dd"));
            using var reader = cmd.ExecuteReader();
            while (reader.Read())
            {
                int userId = reader.GetInt32("user_id");
                if (!logsByUser.TryGetValue(userId, out var attendance))
                {
                    attendance = new AttendanceModel
                    {
                        UserId = userId,
                        FullName = reader.GetString("full_name")
                    };
                    logsByUser.Add(userId, attendance);
                }

                DateTime logTime = reader.GetDateTime("log_time");
                string entryType = reader.GetString("entry_type").Trim();
                if (string.Equals(entryType, "IN", StringComparison.OrdinalIgnoreCase))
                {
                    if (!attendance.TimeIn.HasValue || logTime < attendance.TimeIn.Value)
                        attendance.TimeIn = logTime;
                }
                else if (string.Equals(entryType, "OUT", StringComparison.OrdinalIgnoreCase))
                {
                    if (!attendance.TimeOut.HasValue || logTime > attendance.TimeOut.Value)
                        attendance.TimeOut = logTime;
                }
            }

            return logsByUser.Values
                .OrderByDescending(GetLastAttendanceTime)
                .ToList();
        }

        private static DateTime GetLastAttendanceTime(AttendanceModel attendance)
        {
            if (!attendance.TimeIn.HasValue)
                return attendance.TimeOut ?? DateTime.MinValue;
            if (!attendance.TimeOut.HasValue)
                return attendance.TimeIn.Value;
            return attendance.TimeIn.Value > attendance.TimeOut.Value
                ? attendance.TimeIn.Value
                : attendance.TimeOut.Value;
        }

