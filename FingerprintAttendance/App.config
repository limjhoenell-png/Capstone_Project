<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <!-- 
	OPTIONAL: If you want to store database credentials separately from source code,
	you can use the App.config file. This example shows both approaches.

	Current Implementation: Credentials are in AppDbConnection class (DatabaseHelper.cs)

	ALTERNATIVE: Store credentials here and load them at runtime.
	Uncomment the settings below if you want to use this approach.
  -->

  <appSettings>
	<!-- Database Connection Settings -->
	<!-- Uncomment and modify these values if using App.config for credentials -->
	<!--
	<add key="mysql_host" value="127.0.0.1" />
	<add key="mysql_port" value="3306" />
	<add key="mysql_user" value="root" />
	<add key="mysql_password" value="root" />
	<add key="mysql_database" value="attendance_db" />
	-->

	<!-- Application Settings -->
	<add key="fingerprint_match_threshold" value="50" />
	<add key="connection_timeout_seconds" value="8" />
  </appSettings>

  <startup>
	<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <!-- 
	SQL Connection String (alternative format - not currently used):

	Server=127.0.0.1;Port=3306;Database=attendance_db;Uid=root;Pwd=root;
  -->
</configuration>
